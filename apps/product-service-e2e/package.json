{
  "name": "@eshop/product-service-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "product-service-e2e",
    "implicitDependencies": ["product-service"],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": ["{projectRoot}/test-output/jest/coverage"],
        "options": {
          "jestConfig": "apps/product-service-e2e/jest.config.ts",
          "passWithNoTests": false
        },
        "dependsOn": ["product-service:build"]
      }
    }
  }
}
