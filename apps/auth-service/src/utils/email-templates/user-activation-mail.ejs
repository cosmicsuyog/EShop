<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Email – EShop</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Inter", Arial, sans-serif;
        background-color: #f0f4f8;
        color: #1a202c;
        -webkit-font-smoothing: antialiased;
      }

      .wrapper {
        width: 100%;
        padding: 40px 16px;
        background-color: #f0f4f8;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
      }

      /* ── Header ── */
      .header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 44px 40px 36px;
        text-align: center;
      }

      .logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 24px;
      }

      .logo-icon {
        width: 40px;
        height: 40px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
      }

      .logo-text {
        font-size: 22px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.5px;
      }

      .header-title {
        font-size: 26px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 8px;
        letter-spacing: -0.3px;
      }

      .header-subtitle {
        font-size: 15px;
        color: rgba(255, 255, 255, 0.8);
        font-weight: 400;
      }

      /* ── Body ── */
      .body {
        padding: 40px;
      }

      .greeting {
        font-size: 17px;
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 12px;
      }

      .message {
        font-size: 15px;
        color: #718096;
        line-height: 1.7;
        margin-bottom: 32px;
      }

      /* ── OTP Box ── */
      .otp-section {
        text-align: center;
        margin-bottom: 32px;
      }

      .otp-label {
        font-size: 12px;
        font-weight: 600;
        color: #a0aec0;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 16px;
      }

      .otp-box {
        display: inline-block;
        background: linear-gradient(135deg, #f7f3ff 0%, #ede9fe 100%);
        border: 2px solid #c4b5fd;
        border-radius: 16px;
        padding: 20px 48px;
      }

      .otp-code {
        font-size: 42px;
        font-weight: 800;
        letter-spacing: 12px;
        color: #6d28d9;
        font-variant-numeric: tabular-nums;
      }

      .otp-validity {
        margin-top: 10px;
        font-size: 13px;
        color: #9f7aea;
        font-weight: 500;
      }

      /* ── Divider ── */
      .divider {
        height: 1px;
        background: #e2e8f0;
        margin: 28px 0;
      }

      /* ── Warning ── */
      .warning-box {
        background: #fffbeb;
        border: 1px solid #fcd34d;
        border-radius: 12px;
        padding: 16px 20px;
        display: flex;
        gap: 12px;
        align-items: flex-start;
        margin-bottom: 28px;
      }

      .warning-icon {
        font-size: 18px;
        flex-shrink: 0;
        margin-top: 1px;
      }

      .warning-text {
        font-size: 13px;
        color: #92400e;
        line-height: 1.6;
      }

      .warning-text strong {
        font-weight: 600;
      }

      /* ── Steps ── */
      .steps-title {
        font-size: 13px;
        font-weight: 600;
        color: #a0aec0;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 14px;
      }

      .steps {
        list-style: none;
        margin-bottom: 28px;
      }

      .steps li {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
        color: #4a5568;
        padding: 6px 0;
      }

      .step-badge {
        width: 24px;
        height: 24px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        color: #fff;
        flex-shrink: 0;
      }

      /* ── Footer ── */
      .footer {
        background: #f7fafc;
        border-top: 1px solid #e2e8f0;
        padding: 24px 40px;
        text-align: center;
      }

      .footer-text {
        font-size: 12px;
        color: #a0aec0;
        line-height: 1.7;
      }

      .footer-text a {
        color: #667eea;
        text-decoration: none;
        font-weight: 500;
      }

      .footer-brand {
        margin-top: 12px;
        font-size: 12px;
        color: #cbd5e0;
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="container">

        <!-- Header -->
        <div class="header">
          <div class="logo">
            <div class="logo-icon">🛍️</div>
            <span class="logo-text">EShop</span>
          </div>
          <h1 class="header-title">Verify Your Email</h1>
          <p class="header-subtitle">One step away from your account</p>
        </div>

        <!-- Body -->
        <div class="body">
          <p class="greeting">Hi <%= name %> 👋</p>
          <p class="message">
            Thanks for signing up for <strong>EShop</strong>! To complete your
            registration and activate your account, please use the One-Time
            Password (OTP) below.
          </p>

          <!-- OTP Code -->
          <div class="otp-section">
            <p class="otp-label">Your Verification Code</p>
            <div class="otp-box">
              <div class="otp-code"><%= otp %></div>
              <p class="otp-validity">⏱ Expires in 5 minutes</p>
            </div>
          </div>

          <!-- Warning -->
          <div class="warning-box">
            <span class="warning-icon">⚠️</span>
            <p class="warning-text">
              <strong>Never share this code.</strong> EShop will never ask for
              your OTP via phone, chat, or email. If you didn't request this,
              please ignore this message.
            </p>
          </div>

          <div class="divider"></div>

          <!-- Steps -->
          <p class="steps-title">How to verify</p>
          <ul class="steps">
            <li>
              <span class="step-badge">1</span>
              Go back to the EShop registration page
            </li>
            <li>
              <span class="step-badge">2</span>
              Enter the 4-digit code shown above
            </li>
            <li>
              <span class="step-badge">3</span>
              Your account will be activated instantly
            </li>
          </ul>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p class="footer-text">
            This email was sent to you because an account was created with this
            address. If this wasn't you,
            <a href="#">contact our support team</a>.
          </p>
          <p class="footer-brand">© 2026 EShop. All rights reserved.</p>
        </div>

      </div>
    </div>
  </body>
</html> 