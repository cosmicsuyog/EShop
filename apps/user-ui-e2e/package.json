{
  "name": "@eshop/user-ui-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "user-ui-e2e",
    "implicitDependencies": ["user-ui"],
    "targets": {
      "e2e": {
        "executor": "@nx/playwright:playwright",
        "outputs": ["{projectRoot}/test-results", "{projectRoot}/playwright-report"],
        "options": {
          "config": "apps/user-ui-e2e/playwright.config.ts",
          "skipInstall": true,
          "workers": 1
        },
        "dependsOn": ["user-ui:build"]
      }
    }
  }
}
