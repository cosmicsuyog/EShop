# Copy this file to .env.local. Never put real credentials in this example.
# The local database guard accepts only this loopback host, port, database, and replica set.
DATABASE_URL="mongodb://127.0.0.1:27018/eshop_development?replicaSet=eshop-dev"

# Local Redis; start Redis separately before running authentication workflows.
REDIS_DATABASE_URL="redis://127.0.0.1:6379"

# Replace with separate random secrets for local authentication.
ACCESS_TOKEN_SECRET="replace-with-a-random-secret-of-at-least-32-bytes"
REFRESH_TOKEN_SECRET="replace-with-a-different-random-secret-of-at-least-32-bytes"

USER_UI_ORIGIN="http://localhost:3000"
SELLER_UI_ORIGIN="http://localhost:3001"
NEXT_PUBLIC_API_GATEWAY_URL="http://localhost:8000"
API_GATEWAY_URL="http://localhost:8000"
NEXT_PUBLIC_USER_UI_URL="http://localhost:3000"
NEXT_PUBLIC_SELLER_UI_URL="http://localhost:3001"
AUTH_SERVICE_URL="http://localhost:6001"
PRODUCT_SERVICE_URL="http://localhost:6002"

# Email provider. Configure credentials only in the ignored .env.local.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SERVICE=""
SMTP_USER=""
SMTP_PASS=""

# Optional provider integrations; use test credentials only.
IMAGEKIT_PRIVATE_KEY=""
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_REFRESH_URL="http://localhost:3001/dashboard/payments?status=refresh"
STRIPE_RETURN_URL="http://localhost:3001/dashboard/payments?status=success"
